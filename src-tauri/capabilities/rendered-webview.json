{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "rendered-webview",
  "description": "Capability for the rendered (visible UI) webview — includes opener for external links",
  "windows": ["main", "rendered-webview"],
  "permissions": [
    "opener:default",
    "core:default",
    {
      "identifier": "core:event:allow-listen",
      "allow": [
        {
          "windows": ["rendered-webview"]
        }
      ]
    },
    {
      "identifier": "core:event:allow-emit",
      "allow": [
        {
          "windows": ["rendered-webview"]
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://help.passbolt.com/*"
        },
        {
          "url": "https://www.passbolt.com/*"
        },
        {
          "url": "https://en.wikipedia.org/wiki/Phishing"
        }
      ]
    }
  ]
}
